INTERLIS 2.3;
MODEL Lab_Standorte_Edit (de) AT "https://example.invalid/lab" VERSION "2026-09-17" =
  TOPIC Standorte =
    DOMAIN
      Punkt = COORD 2480000.000 .. 2840000.000, 1070000.000 .. 1300000.000,
        ROTATION 2 -> 1;
    CLASS Organisation =
      Name : MANDATORY TEXT*100;
    END Organisation;
    CLASS Standort =
      Kennung : MANDATORY TEXT*40;
      Name : MANDATORY TEXT*100;
      Geometrie : MANDATORY Punkt;
      UNIQUE Kennung;
    END Standort;
    ASSOCIATION Zustaendigkeit =
      Organisation -- {1} Organisation;
      Standorte -- {0..*} Standort;
    END Zustaendigkeit;
  END Standorte;
END Lab_Standorte_Edit.
